<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle or (site.name + ', ' + site.credential) }}</title>
  <meta name="description" content="{{ pageDescription or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png">
  <link rel="shortcut icon" href="/img/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/img/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/styles.css">
  {% for m in media %}
    {% if m.image %}<link rel="preload" as="image" href="{{ m.image | mediaImage }}">{% endif %}
  {% endfor %}

  {# schema.org structured data: the node for this page, followed by the shared Person and WebSite nodes. #}
  {% set pageNode = {
    "@type": schemaType or "WebPage",
    "@id": site.url + page.url + "#webpage",
    "url": site.url + page.url,
    "name": pageTitle or (site.name + ", " + site.credential),
    "description": pageDescription or site.description,
    "inLanguage": "en",
    "isPartOf": { "@id": schema.websiteId },
    "about": { "@id": schema.personId },
    "mainEntity": { "@id": schema.personId } if schemaType == "ProfilePage" else none,
    "primaryImageOfPage": { "@id": schema.imageId } if schemaType == "ProfilePage" else none
  } %}
  <script type="application/ld+json">
{{ { "@context": "https://schema.org", "@graph": [pageNode] | merge(schema.nodes) } | jsonld | safe }}
  </script>
</head>
<body>
  <div class="page">
    {% include "partials/hero.njk" %}
    {% include "partials/tabnav.njk" %}
    <main class="content">
      <div class="content-inner">
        {{ content | safe }}
      </div>
    </main>
    {% include "partials/footer.njk" %}
  </div>
  {% include "partials/skills-modal.njk" %}
  <script src="/assets/js/network.js" defer></script>
  <script src="/assets/js/tabnav.js" defer></script>
  <script src="/assets/js/spa.js" defer></script>
  <script src="/assets/js/show-more.js" defer></script>
  <script src="/assets/js/dropdown.js" defer></script>
  <script src="/assets/js/skills-modal.js" defer></script>
  {% block scripts %}{% endblock %}
  <script data-goatcounter="https://sepro.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</body>
</html>
